{
  "name": "scaffdev",
  "version": "0.8.0",
  "description": "CLI untuk generate project boilerplate Scaffdev dengan tampilan visual jadi dan kurasi integrasi konteks Indonesia.",
  "keywords": [
    "scaffolding",
    "cli",
    "generator",
    "boilerplate",
    "nextjs",
    "scaffdev"
  ],
  "author": "Scaffdev Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Radityaaa25/scaffdev.git"
  },
  "homepage": "https://scaffdev.vercel.app",
  "license": "SEE LICENSE IN LICENSE.md",
  "bin": {
    "scaffdev": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "dev": "tsup src/index.ts --format cjs --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:audit": "tsc -p scripts/audit-test/tsconfig.json && node scripts/audit-test/dist/scripts/audit-test/run.js",
    "test:foreign": "tsc -p scripts/foreign-add-test/tsconfig.json && node scripts/foreign-add-test/dist/scripts/foreign-add-test/run.js",
    "test:watermark": "tsc -p scripts/watermark-test/tsconfig.json && node scripts/watermark-test/dist/scripts/watermark-test/run.js",
    "test:premium": "tsc -p scripts/premium-test/tsconfig.json && node scripts/premium-test/dist/scripts/premium-test/run.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@scaff/config": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^9",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
