{
  "name": "scaffdev",
  "version": "0.1.0",
  "description": "CLI untuk generate project boilerplate Scaffdev dengan tampilan visual jadi dan kurasi integrasi konteks Indonesia.",
  "keywords": [
    "scaffolding",
    "cli",
    "generator",
    "boilerplate",
    "nextjs",
    "scaffdev"
  ],
  "author": "Scaffdev Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaff-dev/scaffdev.git"
  },
  "homepage": "https://scaff.dev",
  "license": "MIT",
  "bin": {
    "scaffdev": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "dev": "tsup src/index.ts --format cjs --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
